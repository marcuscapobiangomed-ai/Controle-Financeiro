{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Account": {
      "collection": "users/{userId}/accounts",
      "fields": {
        "name": { "type": "string" },
        "institution": { "type": "string" },
        "type": { "type": "string" },
        "initialBalance": { "type": "number" },
        "color": { "type": "string" }
      }
    },
    "Transaction": {
      "collection": "users/{userId}/transactions",
      "fields": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "type": "string" },
        "recurrence": { "type": "string" },
        "recurrenceGroupId": { "type": "string" },
        "recurrenceIndex": { "type": "number" },
        "recurrenceTotalCount": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "InvestmentAsset": {
      "collection": "users/{userId}/investments",
      "fields": {
        "name": { "type": "string" },
        "ticker": { "type": "string" },
        "assetClass": { "type": "string" },
        "institution": { "type": "string" },
        "quantity": { "type": "number" },
        "averagePrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "DividendRecord": {
      "collection": "users/{userId}/dividends",
      "fields": {
        "assetId": { "type": "string" },
        "assetTicker": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "BudgetLimit": {
      "collection": "users/{userId}/budgets",
      "fields": {
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" }
      }
    },
    "FinancialGoal": {
      "collection": "users/{userId}/goals",
      "fields": {
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "category": { "type": "string" }
      }
    }
  }
}
