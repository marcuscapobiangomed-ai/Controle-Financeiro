rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user only accesses their own profile, accounts, transactions, investments, dividends, budgets, and goals
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
